        "jsCode": "for (let item of $input.all()) {\n  // Target the 'text' field coming from your Basic LLM Chain\n  let aiResponse = item.json.text || item.json.output || item.json;\n\n  // If the AI response is a string, remove markdown wrappers and parse it\n  if (typeof aiResponse === 'string') {\n    let cleanString = aiResponse\n      .replace(/```json/gi, '')\n      .replace(/```/g, '')\n      .trim();\n    aiResponse = JSON.parse(cleanString);\n  }\n\n  // Return the clean, parsed JSON object\n  return [{ json: aiResponse }];\n}"
